{
  "switchboard": {
    "connectors": ["monitoring"],
    "data_dir": "/home/switchboard/.local/share/switchboard-native"
  },
  "connectors": {
    "monitoring": {
      "poll_interval_seconds": 300,
      "snapshot_stale_after_seconds": 600,
      "checks": {
        "application": {
          "kind": "endpoint",
          "url": "https://service.example/ready",
          "expected_status": 200,
          "readiness_field": "service.ready",
          "readiness_equals": true,
          "bearer_token": "env:SWITCHBOARD_MONITORING_BEARER",
          "allow_http": false,
          "timeout_seconds": 5
        },
        "nightly_backup": {
          "kind": "backup",
          "directory": "/home/switchboard/monitoring-reports",
          "filename": "nightly.json",
          "max_age_seconds": 86400
        },
        "data_capacity": {
          "kind": "disk",
          "path": "/srv/data",
          "min_free_bytes": 1073741824,
          "min_free_percent": 10
        }
      }
    }
  },
  "policy": {
    "tools": {}
  },
  "mcp": {
    "expose": ["monitoring_status", "monitoring_check"]
  }
}
